        </mxCell>
        <mxCell id="legend-private-text" value="Solid Cyan = Private Backend Connectivity" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1605" width="470" height="40" as="geometry" />
