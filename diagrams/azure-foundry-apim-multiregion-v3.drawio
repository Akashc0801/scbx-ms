        <mxCell id="legend-dns-line" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1900" y="1625" as="sourcePoint" /><mxPoint x="1980" y="1625" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="legend-dns-text" value="Dashed Gray = DNS / VNet Association" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2000" y="1605" width="640" height="40" as="geometry" />
