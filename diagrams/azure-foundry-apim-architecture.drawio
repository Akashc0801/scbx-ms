<mxfile host="app.diagrams.net" type="device">
  <diagram id="azure-foundry-apim" name="Foundry Agent - APIM Model Access">
    <mxGraphModel dx="2460" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2460" pageHeight="1200" math="0" shadow="0" background="#0B1220" adaptiveColors="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Azure AI Foundry Agent Architecture" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="35" width="2200" height="50" as="geometry" />
        </mxCell>
