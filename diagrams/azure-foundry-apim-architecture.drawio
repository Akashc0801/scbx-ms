          <mxGeometry x="1650" y="245" width="340" height="32" as="geometry" />
        </mxCell>
        <mxCell id="models" value="&lt;b&gt;Models&lt;/b&gt;&lt;br&gt;&lt;br&gt;Model deployments&lt;br&gt;exposed through APIM&lt;br&gt;&lt;br&gt;No direct agent-to-model&lt;br&gt;access" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#362254;strokeColor=#B49AFF;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="2150" y="300" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="vnet" value="Customer Azure VNet" style="rounded=1;arcSize=5;container=1;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fillColor=#102331;strokeColor=#22D3EE;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=20;spacingTop=18;" vertex="1" parent="1">
          <mxGeometry x="1680" y="760" width="420" height="290" as="geometry" />
        </mxCell>
        <mxCell id="private-endpoint" value="&lt;b&gt;Private Endpoint&lt;/b&gt;&lt;br&gt;&lt;br&gt;Private IP in endpoint subnet&lt;br&gt;&lt;br&gt;Private connectivity to&lt;br&gt;East US2 Foundry" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#073E4B;strokeColor=#22D3EE;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="vnet">
          <mxGeometry x="110" y="90" width="230" height="150" as="geometry" />
        </mxCell>
        <mxCell id="private-dns" value="Private DNS: backend FQDN resolves to the Private Endpoint IP" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;align=left;verticalAlign=middle;" vertex="1" parent="vnet">
