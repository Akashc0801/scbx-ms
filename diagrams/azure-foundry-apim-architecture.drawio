          <mxGeometry x="50" y="90" width="2200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="intent" value="APIM is the single model API access layer. Connected models are logical configuration, not an extra inference hop." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#FFFFFF;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="2300" height="30" as="geometry" />
        </mxCell>
