        </mxCell>
        <mxCell id="eastus2-region" value="East US2" style="rounded=1;arcSize=5;container=1;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fillColor=#16172E;strokeColor=#A78BFA;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=20;spacingTop=18;" vertex="1" parent="1">
          <mxGeometry x="2130" y="730" width="300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="regional-scope" value="Separate regional Foundry resource&lt;br&gt;Managed service - outside customer VNet" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#FFFFFF;align=left;verticalAlign=middle;" vertex="1" parent="eastus2-region">
          <mxGeometry x="20" y="55" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="eastus2-models" value="&lt;b&gt;East US2 Foundry Models&lt;/b&gt;&lt;br&gt;&lt;br&gt;Model deployments hosted&lt;br&gt;in East US2&lt;br&gt;&lt;br&gt;Accessed through APIM&lt;br&gt;using private connectivity" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#362254;strokeColor=#B49AFF;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="eastus2-region">
          <mxGeometry x="20" y="120" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="design-notes" value="&lt;b&gt;Architecture guardrails and connectivity prerequisites&lt;/b&gt;&lt;br&gt;&lt;br&gt;All runtime model inference goes through APIM (model API); no agent or connected-model configuration connects directly to deployments.&lt;br&gt;&lt;br&gt;The agent identity authenticates to APIM; the APIM managed identity authenticates to model backends with the required RBAC roles.&lt;br&gt;&lt;br&gt;APIM needs VNet integration / injection or routed private reachability (SKU dependent), plus private DNS resolution to the backend Private Endpoint.&lt;br&gt;&lt;br&gt;APIM labels are logical API surfaces and can share one APIM service. Arrows show requests; responses return along the same paths." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#111E31;strokeColor=#334155;strokeWidth=1;fontFamily=Arial;fontSize=16;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="50" y="760" width="1510" height="290" as="geometry" />
        </mxCell>
