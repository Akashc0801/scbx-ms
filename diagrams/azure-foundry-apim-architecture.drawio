        </mxCell>
        <mxCell id="caller" value="&lt;b&gt;Caller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Application / Client&lt;br&gt;&lt;br&gt;Initiates agent requests" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#94A3B8;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="210" height="220" as="geometry" />
        </mxCell>
        <mxCell id="apim-agents" value="&lt;b&gt;APIM (agents API)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Agent API entry point&lt;br&gt;&lt;br&gt;Authentication and&lt;br&gt;authorization&lt;br&gt;&lt;br&gt;Rate limiting and policies" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0C3B68;strokeColor=#38A3FF;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Hosted / Prompt Agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Agent execution and&lt;br&gt;orchestration&lt;br&gt;&lt;br&gt;Uses managed identity&lt;br&gt;&lt;br&gt;Processes prompts and context" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#362254;strokeColor=#B49AFF;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="foundry">
          <mxGeometry x="20" y="110" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="connected-models" value="&lt;b&gt;AI Gateway /&lt;br&gt;Admin Connected Models&lt;/b&gt;&lt;br&gt;&lt;br&gt;Logical model connection configuration&lt;br&gt;Models registered using APIM endpoint&lt;br&gt;Model routing configuration&lt;br&gt;&lt;br&gt;No direct model access" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#103F32;strokeColor=#4ADE80;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="foundry">
          <mxGeometry x="400" y="110" width="340" height="220" as="geometry" />
        </mxCell>
        <mxCell id="config-note" value="Connection configuration only - not a separate runtime network hop" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="foundry">
          <mxGeometry x="400" y="340" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apim-model" value="&lt;b&gt;APIM (model API)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exposes model inference APIs&lt;br&gt;&lt;br&gt;Managed identity for backend auth&lt;br&gt;Model access policies&lt;br&gt;&lt;br&gt;Centralized monitoring and governance" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0C3B68;strokeColor=#38A3FF;strokeWidth=3;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="1650" y="300" width="340" height="220" as="geometry" />
        </mxCell>
