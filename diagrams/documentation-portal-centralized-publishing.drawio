        <mxCell id="ownership" value="OWNERSHIP&lt;br&gt;&lt;br&gt;PortCo teams own their documentation content and contribute changes through Pull Requests.&lt;br&gt;&lt;br&gt;The Central Documentation / Platform Team owns repository governance, shared configuration, publishing automation, and Azure hosting." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=14;fontColor=#172B4D;fillColor=#F2F4F7;strokeColor=#AEB8C5;strokeWidth=1.2;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="990" width="480" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="contribution" value="CONTRIBUTION&lt;br&gt;&lt;br&gt;Authorized contributors from multiple teams update their respective documentation folders through feature branches and Pull Requests.&lt;br&gt;&lt;br&gt;Teams do not publish directly to Azure." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=14;fontColor=#4A2869;fillColor=#F7F1FF;strokeColor=#B596D0;strokeWidth=1.2;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="990" width="480" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="governance-model" value="GOVERNANCE&lt;br&gt;&lt;br&gt;CODEOWNERS, branch protection, required reviewers, automated validation, and central approval ensure documentation quality and consistency.&lt;br&gt;&lt;br&gt;Merge to main only after required checks pass." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=14;fontColor=#75430F;fillColor=#FFF8EE;strokeColor=#D9A15F;strokeWidth=1.2;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="990" width="480" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="publishing-model" value="PUBLISHING&lt;br&gt;&lt;br&gt;Only the Central Documentation / Platform Team publishing pipeline deploys the complete documentation portal to Azure Storage after approved changes are merged into main.&lt;br&gt;&lt;br&gt;One repository. One publishing pipeline." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=14;fontColor=#17365D;fillColor=#EFF5FF;strokeColor=#6D95C8;strokeWidth=1.2;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1530" y="990" width="480" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="security-model" value="SECURITY&lt;br&gt;&lt;br&gt;Team contributors require no Azure Storage access. GitHub Actions uses OIDC and least-privilege Azure RBAC.&lt;br&gt;&lt;br&gt;The documentation portal remains accessible only through the internal network and Private Link." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=14;fontColor=#245331;fillColor=#F1F8F3;strokeColor=#8FB69A;strokeWidth=1.2;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2030" y="990" width="490" height="220" as="geometry"/>
        </mxCell>

