        <mxCell id="gov" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="100" width="2780" x="40" y="895" as="geometry" />
        </mxCell>
        <mxCell id="gov1" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" value="&lt;b&gt;Ownership&lt;/b&gt;&lt;br&gt;Each PortCo owns its content, repo, tooling and release timing. DataX owns the package manager, the security scan, publishing, the preset, the landing page and hosting." vertex="1">
          <mxGeometry height="88" width="520" x="60" y="901" as="geometry" />
        </mxCell>
        <mxCell id="gov2" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" value="&lt;b&gt;Consistency&lt;/b&gt;&lt;br&gt;Every site pins @platform/docs-preset. A new preset release (e.g. a new PortCo in the top bar) must be adopted within the agreed deadline." vertex="1">
          <mxGeometry height="88" width="520" x="610" y="901" as="geometry" />
        </mxCell>
        <mxCell id="gov3" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" value="&lt;b&gt;Quality gate&lt;/b&gt;&lt;br&gt;PortCos run pre-submit checks before submitting. Every package must pass the DataX scan before it can be published. Every release is logged and the previous version stays in blob versioning for rollback. Approved versions are kept in the package manager for rollback." vertex="1">
          <mxGeometry height="88" width="520" x="1160" y="901" as="geometry" />
        </mxCell>
        <mxCell id="gov4" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;No stored secrets. PortCos cannot write to storage; only the DataX publish identity can. Every reader signs in with their PortCo work account; only allow-listed tenants get in (403 otherwise). Content is served only through the sign-in gate over private endpoints. Signed-in readers can see all sections; per-product tenant restrictions are phase 2." vertex="1">
          <mxGeometry height="88" width="520" x="1710" y="901" as="geometry" />
        </mxCell>
        <mxCell id="gov5" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;verticalAlign=top;" value="&lt;b&gt;Onboarding a PortCo&lt;/b&gt;&lt;br&gt;1 · PortCo admin consents to the reader app&lt;br&gt;2 · PortCo shares its tenant ID&lt;br&gt;3 · DataX adds it to the allow-list&lt;br&gt;4 · test sign-in" vertex="1">
          <mxGeometry height="88" width="520" x="2260" y="901" as="geometry" />
        </mxCell>
