        </mxCell>
        <mxCell id="hub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontSize=13;" value="&lt;b&gt;vWAN secured hub&lt;/b&gt;&lt;br&gt;Azure Firewall · DNS Private Resolver" vertex="1">
