        <mxCell id="signinGate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontSize=13;align=left;spacingLeft=10;spacingRight=8;spacingTop=6;" value="&lt;b&gt;Sign-in gate · Azure App Service&lt;/b&gt;&lt;br&gt;Built-in authentication (Entra, multi-tenant, issuer /common/v2.0)&lt;br&gt;Allowed tenants: PortCo tenant IDs (≤10 built-in; gate checks tid beyond 10) · others get 403&lt;br&gt;Managed identity → Storage Blob Data Reader&lt;br&gt;VNet integration · inbound private endpoint · ≥2 instances · staging slot for gate updates&lt;br&gt;&lt;font color=&quot;#B42318&quot;&gt;Not on allow-list → 403&lt;/font&gt;" vertex="1">
          <mxGeometry height="154" width="560" x="1490" y="344" as="geometry" />
        </mxCell>
