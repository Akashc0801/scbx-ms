{
  "name": "Application-Enforce-Enhanced-Security-Controls",
  "properties": {
    "displayName": "Enforce Enhanced Security Controls",
    "description": "This policy initiative enforces enhanced security controls across network infrastructure, container services, and resource access management to strengthen security posture and compliance.",
    "metadata": {
      "version": "1.0.0",
      "category": "Security Center",
      "source": "https://github.com/Akashc0801/scbx-ms",
