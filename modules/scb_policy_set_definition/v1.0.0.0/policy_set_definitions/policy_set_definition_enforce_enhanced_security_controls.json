        "type": "String",
        "metadata": {
          "displayName": "Effect - Deny Management Ports From Internet",
          "description": "Enable or disable the execution of the policy to deny management ports accessible from internet"
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "effectDenySubnetWithoutNsg": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Deny Subnet Without NSG",
          "description": "Enable or disable the execution of the policy to deny subnets without network security groups"
