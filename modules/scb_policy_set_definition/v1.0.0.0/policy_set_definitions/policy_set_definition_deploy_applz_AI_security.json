{
  "name": "SCB-Enterprise-AppLZ-AI-Security",
  "properties": {
    "displayName": "Azure AI, Machine Learning, Cognitive Services and Application Gateway Security Controls",
    "description": "This policy initiative enforces security controls for Azure Machine Learning, Azure AI Services, Cognitive Services, Azure AI Search, and Application Gateway/WAF, including network access restrictions, encryption, identity management, authentication, compute security, WAF enablement, and diagnostic logging.",
    "metadata": {
      "version": "1.0.0",
      "category": "Security Center",
      "source": "SCF-AI-Initiative",
      "alzCloudEnvironments": [
        "AzureCloud"
      ]
    },
    "parameters": {
      "effectMlDisablePublicNetworkAccess": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning Workspaces should disable public network access",
          "description": "Disabling public network access improves security by ensuring that the Machine Learning workspaces aren't exposed on the public internet."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMlUsePrivateLink": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning workspaces should use private link",
          "description": "Azure Private Link lets you connect your virtual network to Azure services without a public IP address at the source or destination."
        },
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMlUserAssignedManagedIdentity": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning workspaces should use user-assigned managed identity",
          "description": "Manage access to Azure Machine Learning workspace and associated resources using user-assigned managed identities."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMlEncryptedWithCmk": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning workspaces should be encrypted with a customer-managed key",
          "description": "Manage encryption at rest of Azure Machine Learning workspace data with customer-managed keys."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMlEncryptedWithCmkAine": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning workspaces should be encrypted with the use of a customer-managed key",
          "description": "Azure Machine Learning workspaces should be encrypted with the use of a customer-managed key (CMK)."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "effectConfigureMlDisablePublicNetworkAccess": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Azure Machine Learning Workspaces to disable public network access",
          "description": "Disable public network access for Azure Machine Learning workspaces so that they are not accessible over the public internet."
        },
        "allowedValues": [
          "Modify",
          "Disabled"
        ],
        "defaultValue": "Modify"
      },
      "effectAiServicesDisableKeyAccess": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure AI Services resources should have key access disabled (disable local authentication)",
          "description": "Key access (local authentication) is recommended to be disabled for security."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectAiServicesRestrictNetworkAccess": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure AI Services resources should restrict network access",
          "description": "By restricting network access, you can ensure that only allowed networks can access the service."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectAiServicesUsePrivateLink": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure AI Services resources should use Azure Private Link",
          "description": "Azure Private Link lets you connect your virtual networks to Azure services without a public IP address at the source or destination."
        },
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectCognitiveServicesManagedIdentity": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Cognitive Services accounts should use a managed identity",
          "description": "Assigning a managed identity to your Cognitive Services account supports secure, Azure AD based authentication."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectCognitiveServicesCustomerOwnedStorage": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Cognitive Services accounts should use customer owned storage",
          "description": "Use customer owned storage to control the data stored in Cognitive Services."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectConfigureCognitiveServicesDisableLocalAuth": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Cognitive Services accounts to disable local authentication methods",
          "description": "Disable local authentication methods so that your Cognitive Services accounts require Azure Active Directory identities exclusively for authentication."
        },
        "allowedValues": [
          "Modify",
          "Disabled"
        ],
        "defaultValue": "Modify"
      },
      "effectConfigureCognitiveServicesDisablePublicNetwork": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Cognitive Services accounts to disable public network access",
          "description": "Disable public network access for your Cognitive Services resource so that it's not accessible over the public internet."
        },
        "allowedValues": [
          "Disabled",
          "Modify"
        ],
        "defaultValue": "Modify"
      },
      "effectDiagnosticLogsAiServices": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Diagnostic logs in Azure AI services resources should be enabled",
          "description": "Enable diagnostic logs for Azure AI services resources. This enables you to recreate activity trails for investigation purposes."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "effectAiSearchZoneRedundant": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - [Preview]: Azure AI Search Service should be Zone Redundant",
          "description": "Azure AI Search Service should be Zone Redundant to ensure high availability."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectAiSearchSkuSupportsPrivateLink": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure AI Search service should use a SKU that supports private link",
          "description": "With supported SKUs of Azure AI Search, Azure Private Link lets you connect your virtual network to Azure services."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectAiSearchDisablePublicNetworkAccess": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure AI Search services should disable public network access",
          "description": "Disabling public network access improves security by ensuring that your Azure AI Search service is not exposed on the public internet."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectAiSearchDisableLocalAuth": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure AI Search services should have local authentication methods disabled",
          "description": "Disabling local authentication methods improves security by ensuring that Azure AI Search services exclusively require Azure Active Directory identities for authentication."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectAiSearchCmkEncryption": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure AI Search services should use customer-managed keys to encrypt data at rest",
          "description": "Using customer-managed keys to encrypt data at rest in Azure AI Search services provides additional control over the key used for encryption."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "effectConfigureAiSearchDisableLocalAuth": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Azure AI Search services to disable local authentication",
          "description": "Disable local authentication methods so that your Azure AI Search services exclusively require Azure Active Directory identities for authentication."
        },
        "allowedValues": [
          "Modify",
          "Disabled"
        ],
        "defaultValue": "Modify"
      },
      "effectConfigureAiSearchDisablePublicNetworkAccess": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Azure AI Search services to disable public network access",
          "description": "Disable public network access for your Azure AI Search service so that it is not accessible over the public internet."
        },
        "allowedValues": [
          "Modify",
          "Disabled"
        ],
        "defaultValue": "Modify"
      },
      "effectConfigureAiSearchEnforceCmk": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Azure AI Search services to enforce customer-managed keys to encrypt data at rest",
          "description": "Enforce the use of customer-managed keys to encrypt data at rest in Azure AI Search services."
        },
        "allowedValues": [
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "effectWafEnabledForAppGateway": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Web Application Firewall (WAF) should be enabled for Application Gateway",
          "description": "Deploy Azure Web Application Firewall (WAF) in front of public facing web applications for additional inspection of incoming traffic."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectAppGatewayDeployedWithWaf": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Application Gateway should be deployed with Azure WAF",
          "description": "Requires Azure Application Gateway resources to be deployed with Azure WAF."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectWafRequestBodyInspection": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Web Application Firewall on Azure Application Gateway should have request body inspection enabled",
          "description": "Ensure that Web Application Firewalls associated to Azure Application Gateways have request body inspection enabled."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectBotProtectionEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Bot Protection should be enabled for Azure Application Gateway WAF",
          "description": "This policy ensures that Bot Protection is enabled in all Azure Application Gateway Web Application Firewall (WAF) policies."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMigrateWafConfigToPolicy": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Migrate WAF from WAF Config to WAF Policy on Application Gateway",
          "description": "If you have WAF Config instead of WAF Policy, then you may want to move to the new WAF Policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectAppGatewayContainersSecurityPolicies": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Application Gateway for Containers must have security policies",
          "description": "Ensure that Azure Application Gateway for Containers has security policies configured."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "effectAppGatewayResourceLogsEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Application Gateway should have Resource logs enabled",
          "description": "Enable Resource logs for Azure Application Gateway (plus WAF) and stream to a Log Analytics workspace."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "effectDenyCognitiveServicesNetworkAcls": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Network ACLs should be restricted for Cognitive Services",
          "description": "Network ACLs should be restricted for Cognitive Services to prevent unauthorized network access."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "effectDenyCognitiveServicesRestrictOutboundNetworkAccess": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Outbound network access should be restricted for Cognitive Services",
          "description": "Outbound network access should be restricted for Cognitive Services to prevent data exfiltration."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "effectMlComputeIdleShutdown": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning Compute Instance should have idle shutdown",
          "description": "Idle shutdown policy reduces cost by shutting down compute instances that are idle."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMlComputeRecreatedForUpdates": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning compute instances should be recreated to get the latest software updates",
          "description": "Ensure that Azure Machine Learning compute instances run on the latest available operating system with latest security patches and software updates."
        },
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMlComputeInVnet": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning Computes should be in a virtual network",
          "description": "Azure Virtual Networks provide enhanced security and isolation for your Azure Machine Learning Computes."
        },
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMlComputeLocalAuthDisabled": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning Computes should have local auth disabled",
          "description": "Disabling local authentication methods improves security by ensuring that Machine Learning Computes require Azure Active Directory identities exclusively for authentication."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectMlEnableV1LegacyMode": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Machine Learning workspaces should enable V1LegacyMode",
          "description": "Azure Machine Learning workspaces should enable V1LegacyMode to ensure network isolation backward compatibility."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectConfigureMlComputeDisableLocalAuth": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Azure Machine Learning Computes to disable local auth",
          "description": "Configure Azure Machine Learning Computes to disable local authentication methods."
        },
        "allowedValues": [
          "Modify",
          "Disabled"
        ],
        "defaultValue": "Modify"
      }
    },
