{
  "name": "SCB-Enterprise-Initiative-Platform",
  "properties": {
    "displayName": "SCB Enterprise Initiative Platform",
    "description": "This inlcudes all the policies related to Platform Landing Zones.",
    "metadata": {
      "category": "Governance"
    },
    "parameters": {
      "subnetEffect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "listOfResourceTypesDisallowedForDeletion": {
        "type": "Array",
        "metadata": {
          "displayName": "Resource types that cannot be deleted",
          "description": "The list of resource types that cannot be deleted.",
          "strongType": "resourceTypes"
        }
      },
      "resourceDeletionEffect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DenyAction",
          "Disabled"
        ],
        "defaultValue": "DenyAction"
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "Subnets should be private_1",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7bca8353-aa3b-429b-904a-9229c4385837",
        "parameters": {
          "effect": {
            "value": "[parameters('subnetEffect')]"
          }
        },
        "groupNames": []
      },
      {
        "policyDefinitionReferenceId": "Do not allow deletion of resource types_1",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/78460a36-508a-49a4-b2b2-2f5ec564f4bb",
        "parameters": {
          "effect": {
            "value": "[parameters('resourceDeletionEffect')]"
          },
          "listOfResourceTypesDisallowedForDeletion": {
            "value": "[parameters('listOfResourceTypesDisallowedForDeletion')]"
          }
        },
        "groupNames": []
      }
    ]
  }
}