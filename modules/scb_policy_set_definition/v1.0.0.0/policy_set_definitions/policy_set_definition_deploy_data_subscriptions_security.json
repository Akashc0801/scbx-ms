        },
        "defaultValue": []
      },
      "effectAdfIntegrationRuntimeCores": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Data Factory integration runtime should have a limit for number of cores",
          "description": "Limit the number of cores for Data Factory integration runtime."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "adfMaxCores": {
