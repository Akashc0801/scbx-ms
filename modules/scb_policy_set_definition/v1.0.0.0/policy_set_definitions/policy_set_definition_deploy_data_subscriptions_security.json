          "displayName": "Allowed Domain Names - ADF Pipelines",
          "description": "The list of allowed domain names for ADF pipelines. As per deployment/infra configuration of environment."
        },
        "defaultValue": []
      },
      "effectConfigureAdfPE": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure private endpoints for Data factories",
          "description": "Configure private endpoints for Azure Data Factory. As per deployment/infra configuration of environment."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "adfPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Subnet ID - Azure Data Factory",
          "description": "The subnet resource ID for the Data Factory private endpoint. As per deployment/infra configuration of environment."
