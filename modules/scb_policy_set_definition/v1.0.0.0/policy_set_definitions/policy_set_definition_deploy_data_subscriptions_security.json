          "displayName": "Group ID - ADF Private Endpoint",
          "description": "The group ID (target sub-resource) for the Data Factory private endpoint."
        },
        "allowedValues": [
          "dataFactory",
          "portal"
        ],
        "defaultValue": "dataFactory"
      },
      "effectSqlAuditingEnabled": {
