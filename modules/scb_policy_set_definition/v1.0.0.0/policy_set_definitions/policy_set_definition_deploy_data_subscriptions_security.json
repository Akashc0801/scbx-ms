{
  "name": "SCB-Enterprise-Data-Subscriptions-Security",
  "properties": {
    "displayName": "Azure Data Subscriptions Security Controls",
    "description": "This policy initiative enforces security controls for Data subscriptions, including network isolation, encryption, identity management, authentication, diagnostic logging, and data protection for ADLS Gen2/Azure Storage, Event Hub, Event Grid, Azure Data Factory, Azure SQL Database, and Logic Apps.",
    "metadata": {
      "version": "1.0.0",
      "category": "Security Center",
      "source": "SCF-Data-Subscriptions-Initiative",
      "alzCloudEnvironments": [
        "AzureCloud"
      ]
    },
    "parameters": {
      "effectStorageMinTls": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Storage accounts should have the specified minimum TLS version",
          "description": "Enforce minimum TLS version for Storage accounts."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "storageMinimumTlsVersion": {
        "type": "String",
        "metadata": {
          "displayName": "Minimum TLS Version - Storage Accounts",
          "description": "The minimum TLS version for Storage accounts."
        },
        "defaultValue": "TLS1_2"
      },
      "effectConfigureStoragePrivateLink": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Storage account to use a private link connection",
          "description": "Configure private link for Storage accounts. As per deployment/infra configuration of environment."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "storagePrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Subnet ID - Storage Account",
          "description": "The subnet resource ID for the Storage account private endpoint. As per deployment/infra configuration of environment."
        }
      },
      "storageTargetSubResource": {
        "type": "String",
        "metadata": {
          "displayName": "Target Sub Resource - Storage Account Private Link",
          "description": "The target sub-resource for the Storage account private link connection."
        },
        "allowedValues": [
          "blob",
          "blob_secondary",
          "table",
          "table_secondary",
          "queue",
          "queue_secondary",
          "file",
          "web",
          "web_secondary",
          "dfs",
          "dfs_secondary"
        ],
        "defaultValue": "blob"
      },
      "effectStorageDiagToLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure diagnostic settings for Storage Accounts to Log Analytics",
          "description": "Configure diagnostic settings for Storage Accounts to Log Analytics workspace."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "effectBlobDiagToLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure diagnostic settings for Blob Services to Log Analytics",
          "description": "Configure diagnostic settings for Blob Services to Log Analytics workspace."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "storageMetricsEnabled": {
        "type": "Boolean",
        "metadata": {
          "displayName": "Storage Metrics Enabled",
          "description": "Whether to enable metrics for Storage diagnostic settings (Boolean type for Storage/Blob diagnostics policies 59759c62 and b4fe1a3b)."
        },
        "allowedValues": [
          true,
          false
        ],
        "defaultValue": true
      },
      "storageBlobLogsEnabled": {
        "type": "Boolean",
        "metadata": {
          "displayName": "Storage Blob Logs Enabled",
          "description": "Whether to enable logs for Blob Services diagnostic settings (Boolean type for Blob diagnostics policy b4fe1a3b)."
        },
        "allowedValues": [
          true,
          false
        ],
        "defaultValue": true
      },
      "effectConfigureEventHubPE": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Event Hub namespaces with private endpoints",
          "description": "Configure private endpoints for Event Hub namespaces. As per deployment/infra configuration of environment."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "eventHubPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Subnet ID - Event Hub",
          "description": "The subnet resource ID for the Event Hub private endpoint. As per deployment/infra configuration of environment."
        }
      },
      "effectEventHubResourceLogs": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Resource logs in Event Hub should be enabled",
          "description": "Enable resource logs for Event Hub."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "eventHubRetentionDays": {
        "type": "String",
        "metadata": {
          "displayName": "Required Retention Days - Event Hub Resource Logs",
          "description": "The required diagnostic logs retention in days for Event Hub."
        },
        "defaultValue": "90"
      },
      "effectEventHubDiagToEventHub": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Deploy Diagnostic Settings for Event Hub to Event Hub",
          "description": "Deploy diagnostic settings for Event Hub to Event Hub."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "effectEventHubDiagToLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Deploy Diagnostic Settings for Event Hub to Log Analytics",
          "description": "Deploy diagnostic settings for Event Hub to Log Analytics workspace."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
