        "type": "String",
        "metadata": {
          "displayName": "Effect - Azure Data Factory linked service resource type should be in allow list",
          "description": "Restrict Data Factory linked service resource types to an allowed list."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
