        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Azure Event Grid domains with private endpoints",
          "description": "Configure private endpoints for Azure Event Grid domains. As per deployment/infra configuration of environment."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "eventGridDomainsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Subnet ID - Event Grid Domains",
          "description": "The subnet resource ID for the Event Grid domains private endpoint. As per deployment/infra configuration of environment."
        }
      },
      "effectConfigureEventGridTopicsPE": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Configure Azure Event Grid topics with private endpoints",
          "description": "Configure private endpoints for Azure Event Grid topics. As per deployment/infra configuration of environment."
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "eventGridTopicsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Subnet ID - Event Grid Topics",
          "description": "The subnet resource ID for the Event Grid topics private endpoint. As per deployment/infra configuration of environment."
        }
      },
