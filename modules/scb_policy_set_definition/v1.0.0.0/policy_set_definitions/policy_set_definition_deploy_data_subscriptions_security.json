        "defaultValue": 32
      },
      "effectAdfAllowedDomains": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - [Preview]: ADF pipelines should only communicate with allowed domains",
          "description": "Restrict ADF pipelines to communicate only with allowed domains."
        },
        "allowedValues": [
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "adfAllowedDomainNames": {
        "type": "Array",
