{
  "type": "Microsoft.Authorization/policyDefinitions",
  "apiVersion": "2021-06-01",
  "name": "SBX_Policy_007",
  "properties": {
    "displayName": "SCF - Manual attestation for validating automatic purge in case of compromise",
    "policyType": "Custom",
    "mode": "All",
    "description": "In case of sandbox compromise detected by automated threat monitoring, the environment must be automatically purged. This control can be exempted for cybersecurity testing.",
    "metadata": {
      "Description": "In case of sandbox compromise detected by automated threat monitoring, the environment must be automatically purged. This control can be exempted for cybersecurity testing.",
      "Responsible teams": [
        "Security Operations"
      ],
      "category": "Compliance",
      "createdBy": "695b7068-08dc-4778-b824-e8a1087605e1",
