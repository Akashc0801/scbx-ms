{
  "type": "Microsoft.Authorization/policyDefinitions",
  "apiVersion": "2021-06-01",
  "name": "SEC_Policy_075",
  "properties": {
    "displayName": "SCF - Manual Attestation for Sandbox Environment Isolation",
    "policyType": "Custom",
    "mode": "All",
    "description": "This policy requires manual attestation to ensure that Sandbox environments are fully isolated from a private interconnect network and are only connected to and accessible from the public internet.",
    "metadata": {
      "Description": "This policy requires manual attestation to ensure that Sandbox environments are fully isolated from a private interconnect network and are only connected to and accessible from the public internet.",
      "Responsible teams": [
        "Platform"
      ],
      "category": "Compliance",
      "createdBy": "695b7068-08dc-4778-b824-e8a1087605e1",
      "createdOn": "2025-09-25T08:22:55.8043114Z",
      "deployedBy": "epac/13b032ea-fae8-4455-b845-679a21e9cdd4/epac-scf",
      "pacOwnerId": "13b032ea-fae8-4455-b845-679a21e9cdd4",
      "securityCenter": {
        "severity": "Medium"
      },
      "severity": "Medium",
      "updatedBy": "695b7068-08dc-4778-b824-e8a1087605e1",
      "updatedOn": "2025-10-13T12:06:29.2820275Z"
    },
    "version": "1.0.0",
    "parameters": {
      "effect": {
        "allowedValues": [
          "Manual",
          "Disabled"
        ],
        "defaultValue": "Manual",
        "metadata": {
          "description": "Enable or disable the execution of the policy",
          "displayName": "Effect"
        },
        "type": "String"
      }
    },
    "policyRule": {
      "if": {
        "equals": "Microsoft.Resources/subscriptions",
        "field": "type"
      },
      "then": {
        "details": {
          "defaultState": "Unknown"
        },
        "effect": "[parameters('effect')]"
      }
    },
    "versions": [
      "1.0.0"
    ]
  },
