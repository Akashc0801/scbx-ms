  "name": "SEC_Policy_068",
  "properties": {
    "displayName": "SCF - Manual Attestation for Forensic Capture Capabilities",
    "policyType": "Custom",
    "mode": "All",
    "description": "This policy requires manual attestation to ensure the provision of forensic capture capabilities to snapshot potentially compromised cloud virtual machines and related security events.",
