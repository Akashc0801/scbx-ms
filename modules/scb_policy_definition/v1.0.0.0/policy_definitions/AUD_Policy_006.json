  "name": "AUD_Policy_006",
  "properties": {
    "displayName": "SCF - Manual attestation for restriction of audit logs access",
    "policyType": "Custom",
    "mode": "All",
    "description": "This policy requires manual attestation to validate access to audit logs is restricted to only those individuals who are responsible for monitoring operations on the control plane",
