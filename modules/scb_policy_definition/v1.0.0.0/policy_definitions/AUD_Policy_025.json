{
  "type": "Microsoft.Authorization/policyDefinitions",
  "apiVersion": "2021-06-01",
  "name": "AUD_Policy_025",
  "properties": {
    "displayName": "SCF - Manual attestation for online retainment period of audit logs ",
    "policyType": "Custom",
    "mode": "All",
    "description": "This policy requires manual attestation to validate audit Logs retain log events in accordance with the Caelum Data Retention Standard or as required by law or regulation, whichever is more stringent",
    "metadata": {
      "Description": "This policy requires manual attestation to validate audit Logs retain log events in accordance with the Caelum Data Retention Standard or as required by law or regulation, whichever is more stringent",
      "Responsible teams": [
        "Platform"
      ],
      "category": "Compliance",
      "createdBy": "695b7068-08dc-4778-b824-e8a1087605e1",
