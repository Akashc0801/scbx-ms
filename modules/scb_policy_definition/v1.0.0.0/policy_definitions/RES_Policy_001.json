{
  "type": "Microsoft.Authorization/policyDefinitions",
  "apiVersion": "2021-06-01",
  "name": "RES_Policy_001",
  "properties": {
    "displayName": "SCF - Manual attestation for validating usage of CICD to deploy cloud infrastructure",
    "policyType": "Custom",
    "mode": "All",
    "description": "All cloud infrastructure must be declared and deployed through code, scripts and templates by using a CI/CD based release pipeline. This control can be exempted for development environments.",
    "metadata": {
      "Description": "All cloud infrastructure must be declared and deployed through code, scripts and templates by using a CI/CD based release pipeline. This control can be exempted for development environments.",
      "Responsible teams": [
        "Platform"
      ],
      "category": "Compliance",
      "createdBy": "695b7068-08dc-4778-b824-e8a1087605e1",
      "createdOn": "2025-09-25T08:21:57.056549Z",
      "deployedBy": "epac/13b032ea-fae8-4455-b845-679a21e9cdd4/epac-scf",
      "pacOwnerId": "13b032ea-fae8-4455-b845-679a21e9cdd4",
      "securityCenter": {
        "severity": "Medium"
      },
      "severity": "Medium",
      "updatedBy": "695b7068-08dc-4778-b824-e8a1087605e1",
      "updatedOn": "2025-10-13T12:06:35.4756795Z"
    },
    "version": "1.0.0",
    "parameters": {
      "effect": {
        "allowedValues": [
          "Manual",
          "Disabled"
        ],
        "defaultValue": "Manual",
        "metadata": {
          "description": "Enable or disable the execution of the policy",
          "displayName": "Effect"
        },
        "type": "String"
      }
    },
    "policyRule": {
      "if": {
        "equals": "Microsoft.Resources/subscriptions",
        "field": "type"
      },
      "then": {
        "details": {
          "defaultState": "Unknown"
        },
        "effect": "[parameters('effect')]"
      }
    },
    "versions": [
      "1.0.0"
    ]
  },
