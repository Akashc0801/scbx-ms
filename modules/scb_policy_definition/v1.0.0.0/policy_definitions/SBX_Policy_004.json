      "pacOwnerId": "13b032ea-fae8-4455-b845-679a21e9cdd4",
      "securityCenter": {
        "severity": ""
      },
      "severity": "Medium",
      "updatedBy": "695b7068-08dc-4778-b824-e8a1087605e1",
      "updatedOn": "2025-10-13T12:06:42.1896134Z"
    },
    "version": "1.0.0",
    "parameters": {
      "effect": {
        "allowedValues": [
          "Manual",
          "Disabled"
        ],
        "defaultValue": "Manual",
        "metadata": {
          "description": "Enable or disable the execution of the policy",
          "displayName": "Effect"
        },
        "type": "String"
      }
    },
    "policyRule": {
      "if": {
        "equals": "Microsoft.Resources/subscriptions",
        "field": "type"
      },
      "then": {
        "details": {
          "defaultState": "Unknown"
        },
        "effect": "[parameters('effect')]"
      }
    },
