  "name": "SBX_Policy_004",
  "properties": {
    "displayName": "SCF - Manual attestation for validating Sandbox environments are automatically purged after fixed number of days",
    "policyType": "Custom",
    "mode": "All",
    "description": "Automatically purge environments after 30 days to conclude the sandbox usage or to trigger a redeployment of up-to-date systems",
    "metadata": {
      "Description": "Automatically purge environments after 30 days to conclude the sandbox usage or to trigger a redeployment of up-to-date systems",
      "Responsible teams": [
        "Platform"
      ],
      "category": "Compliance",
