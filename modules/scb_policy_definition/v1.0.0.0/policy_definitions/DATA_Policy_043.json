{
  "type": "Microsoft.Authorization/policyDefinitions",
  "apiVersion": "2021-06-01",
  "name": "DATA_Policy_043",
  "properties": {
    "displayName": "SCF - Allowed Key Vault SKUs",
    "policyType": "Custom",
    "mode": "All",
    "description": "Audits Key Vault SKUs",
    "metadata": {
      "createdBy": "695b7068-08dc-4778-b824-e8a1087605e1",
      "createdOn": "2025-09-25T08:13:51.2427045Z",
      "deployedBy": "epac/13b032ea-fae8-4455-b845-679a21e9cdd4/epac-scf",
      "pacOwnerId": "13b032ea-fae8-4455-b845-679a21e9cdd4",
      "updatedBy": "695b7068-08dc-4778-b824-e8a1087605e1",
      "updatedOn": "2025-10-13T12:06:42.7761112Z",
      "category": "Compliance",
      "severity": "Medium"
    },
    "version": "1.0.0",
    "parameters": {
      "allowedKeyVaultSKUSetting": {
        "defaultValue": "Premium",
        "metadata": {
          "description": "The allowed SKU setting of an Azure Key Vault",
          "displayName": "Allowed Key Vault SKU Setting"
        },
        "type": "String"
      },
      "effect": {
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "description": "Audit or Disabled the execution of the Policy",
          "displayName": "Effect"
        },
        "type": "String"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "equals": "Microsoft.KeyVault/vaults",
            "field": "type"
          },
          {
            "field": "Microsoft.KeyVault/vaults/sku.name",
            "notEquals": "[parameters('allowedKeyVaultSKUSetting')]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    },
    "versions": [
      "1.0.0"
    ]
  },
  "id": "/providers/Microsoft.Management/managementGroups/SCF/providers/Microsoft.Authorization/policyDefinitions/e117f091-6101-408b-aeca-62f227d37e6d"
}
