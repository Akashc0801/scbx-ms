run "hierarchy_and_roles" {
  command = apply
  assert {
    condition     = length(module.policy_assignment) == 87
    error_message = "Every workbook row must have its own assignment."
  }
  assert {
    condition     = length([for p in values(output.policy_role_report) : p if endswith(p.scope, "/test-ai-nonprod")]) == 37 && length([for p in values(output.policy_role_report) : p if endswith(p.scope, "/test-ai-gateway")]) == 21 && length([for p in values(output.policy_role_report) : p if endswith(p.scope, "/test-ai-agent")]) == 29
    error_message = "Both policies must be assigned once to AI Non-Prod; child assignments must stay in their child MG."
  }
  assert {
    condition     = alltrue([for key, p in local.policies : (module.policy_assignment[key].principal_id != null) == contains(["DeployIfNotExists", "Modify"], p.effect)])
    error_message = "Only effective remediation policies should create identities."
  }
  assert {
    condition     = length(module.policy_assignment["ai_nonprod-0884adba-2312-4468-abeb-5422caed1038"].identity_role_assignments) == 1 && length(module.policy_assignment["ai_nonprod-f5b29bc4-feca-4cc6-a58a-772dd5e290a5"].identity_role_assignments) == 1 && length(module.policy_assignment["ai_nonprod-1f3afdf9-d0c9-4c3d-847f-89da613e70a8"].identity_role_assignments) == 0
    error_message = "Logging initiatives require child roles; the audit baseline must not receive remediation grants."
  }
  assert {
    condition     = local.policy_parameters["ai_gateway-7ca8c8ac-3a6e-493d-99ba-c5fa35347ff2"].effect.value == "DeployIfNotExists" && local.policy_parameters["ai_gateway-df73bd95-24da-4a4f-96b9-4e8b94b402bd"].effect.value == "AuditIfNotExists" && local.policy_parameters["ai_nonprod-0fc55270-f8bf-4feb-b7b8-5e7e7eacc6a6"].effect.value == "AuditIfNotExists"
    error_message = "Approved effect corrections must be applied."
  }
  assert {
    condition     = local.policy_parameters["ai_nonprod-f5b29bc4-feca-4cc6-a58a-772dd5e290a5"].diagnosticSettingName.value != local.policy_parameters["ai_nonprod-0884adba-2312-4468-abeb-5422caed1038"].diagnosticSettingName.value && local.policy_parameters["ai_nonprod-68ba9fc9-71b9-4e6f-9cf5-ecc07722324c"].categoryGroup.value == "allLogs"
    error_message = "Audit settings must not overwrite allLogs; standalone children must use allLogs."
  }
  assert {
    condition     = alltrue([for key, grant in module.destination_role_assignments.azure_resource_manager_role_assignments : grant.principal_id == module.policy_assignment[local.destination_roles[key].assignment].principal_id && grant.scope == local.destination_roles[key].scope && grant.role_definition_id == local.destination_roles[key].role_id])
    error_message = "Each destination grant must use its policy identity and the precise destination resource scope."
  }
}

